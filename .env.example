# ========== 环境 ==========
# testnet / mainnet
BINANCE_ENV=testnet

# 应用监听端口
APP_HOST=127.0.0.1
APP_PORT=8000

# 会话 cookie 密钥（首次启动若为空会自动生成写回 .env，也可手动填）
SESSION_SECRET=

# PIN（明文，仅首次初始化时使用）
# 首次启动若 APP_PIN_HASH 为空但 APP_PIN 有值，会自动 hash 写 DB；之后应清空 APP_PIN
APP_PIN=
APP_PIN_HASH=

# ========== 币安 API Key（启动时用 PIN 派生密钥解密） ==========
# Fernet 密文，存 DB 的 api_keys 表；.env 仅作运维备份占位
BINANCE_API_KEY_ENCRYPTED=
BINANCE_API_SECRET_ENCRYPTED=

# ========== 币安 endpoint（留空则按 BINANCE_ENV 取默认值） ==========
# testnet 默认:
#   BINANCE_REST_BASE=https://testnet.binancefuture.com
#   BINANCE_WS_BASE=wss://stream.binancefuture.com
# mainnet 默认:
#   BINANCE_REST_BASE=https://fapi.binance.com
#   BINANCE_WS_BASE=wss://fstream.binance.com
BINANCE_REST_BASE=
BINANCE_WS_BASE=

# ========== SQLite ==========
# 留空用项目默认（<项目根>/data/app.db）；需要自定义绝对路径再填
DATABASE_URL=

# ========== AI（可选，W5 再用） ==========
LITELLM_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# ========== 通知（可选，W6 再用） ==========
TG_BOT_TOKEN=
TG_CHAT_ID=

# ========== 部署（W6） ==========
CADDY_DOMAIN=
CADDY_ALLOWED_IP=
